# Copy only into a deployment secret manager or local .env. Never commit populated values.
NODE_ENV=development
PORT=4000
REQUIRE_HTTPS=false

# Browser origins allowed to send credentialed calls. Use HTTPS outside local development.
CORS_ORIGINS=http://localhost:8080,https://workspace-staging.somasyncai.com,https://calendar-staging.somasyncai.com

# Secure root-domain session cookies. For local development, use localhost-compatible values.
COOKIE_DOMAIN=.somasyncai.com
SESSION_COOKIE_NAME=somasync_session
CSRF_COOKIE_NAME=somasync_csrf
CSRF_HMAC_SECRET=store-a-unique-32-plus-character-secret-in-secret-manager
SESSION_TTL_SECONDS=28800
ALLOW_BEARER_API_TOKENS=false

# Gateway resource limits.
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_CONNECTIONS_PER_USER=2
WS_MAX_MESSAGES_PER_MINUTE=600
WS_MAX_SESSION_SECONDS=10800

# Supabase Auth identity verification. The API validates a token once, then issues HttpOnly cookies.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key-from-staging-secret-manager
SUPABASE_JWKS_URL=https://your-staging-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-staging-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Server-only services. Never expose these in static JavaScript or Vercel public variables.
DEEPGRAM_API_KEY=store-in-secret-manager
DEEPGRAM_MODEL=nova-3
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=choose-a-bedrock-model-with-strict-tool-use-support

# Staging database only. Apply the migrations manually after authorization.
DATABASE_URL=postgresql://somasync_app:replace-me@staging-host:5432/somasync
DB_SSL=true
# DB_CA_CERT_BASE64=
