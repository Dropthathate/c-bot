# Public browser configuration only. VITE_* values are embedded in the built frontend.
# For local development, VITE_CLINICAL_API_URL may be omitted and defaults to http://localhost:4000/api/v1.
# Production beta-email capture requires both Supabase values below. The Vite build fails if either is missing
# or if the Supabase URL is not HTTPS. Configure them in the frontend host’s encrypted environment-variable settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-supabase-key

# Recommended for every deployment. The public SomaSync production domains fall back to the approved
# deployed API URL if this value is omitted, so an accidentally missing public Vercel variable does not
# disable clinician-reviewed SOAP drafting. Set an explicit HTTPS URL for preview or nonstandard hosts.
# VITE_CLINICAL_API_URL=https://your-api.somasyncai.com/api/v1

# Never use a service-role key, provider secret, database credential, or clinical data in this file.
