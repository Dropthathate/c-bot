# Public browser configuration only. VITE_* values are embedded in the built frontend.
# For local development, VITE_CLINICAL_API_URL may be omitted and defaults to http://localhost:4000/api/v1.
# For production, all three variables are mandatory. The Vite build intentionally fails if any are missing
# or if either URL points to localhost or another non-HTTPS endpoint.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-supabase-key
VITE_CLINICAL_API_URL=https://your-api.somasyncai.com/api/v1

# Never use a service-role key, provider secret, database credential, or clinical data in this file.
# Configure production values in the hosting provider’s encrypted environment-variable settings.
