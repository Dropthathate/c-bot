# Public static-build configuration only. Values are copied into assets/runtime-config.js at build time.
# Never put a service-role key, provider secret, database credential, or JWT in this file.

# Existing public beta-capture configuration.
VITE_SUPABASE_PROJECT_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-supabase-key

# Main voice API. The application converts this HTTPS origin to WSS when no explicit WS URL is supplied.
VITE_CLINICAL_API_URL=https://api.somasyncai.com
# VITE_STT_WEBSOCKET_URL=wss://api.somasyncai.com/api/v1/voice/stream

# Calendar application and its same-origin API proxy.
VITE_CALENDAR_ORIGIN=https://calendar.somasyncai.com
VITE_CALENDAR_API_ORIGIN=https://calendar.somasyncai.com

# Populate only after companion hardware GATT UUIDs are finalized.
VITE_BLUETOOTH_NAME_PREFIX=SomaSync
# VITE_BLUETOOTH_SERVICE_UUID=
# VITE_BLUETOOTH_TELEMETRY_CHARACTERISTIC_UUID=
# VITE_BLUETOOTH_CONTROL_CHARACTERISTIC_UUID=
VITE_AUDIO_SAMPLE_RATE=16000
VITE_AUDIO_CHUNK_MILLISECONDS=80
