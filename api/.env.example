# Copy to .env locally. Never commit a populated .env file or a private key.
NODE_ENV=development
PORT=4000
REQUIRE_HTTPS=false

# Comma-separated browser origins allowed to send credentialed calls.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,https://www.somasyncai.com,https://calendar.somasyncai.com
APP_ORIGIN=https://www.somasyncai.com
CALENDAR_ORIGIN=https://calendar.somasyncai.com

# Root-domain session cookies are Secure in production and never readable by JavaScript.
COOKIE_DOMAIN=.somasyncai.com
SESSION_COOKIE_NAME=somasync_session
CSRF_COOKIE_NAME=somasync_csrf
SESSION_TTL_SECONDS=28800

# Supabase Auth validates a one-time identity token before the API sets HttpOnly cookies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Server-only transcription and model credentials. Never add these to a browser file.
DEEPGRAM_API_KEY=replace-with-secret-manager-value
DEEPGRAM_MODEL=nova-3
AWS_REGION=us-east-1
# Use an Anthropic Bedrock model with forced tool-use support for strict SOAP output.
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

DATABASE_URL=postgresql://somasync_app:replace-me@localhost:5432/somasync
DB_SSL=false
# DB_CA_CERT_BASE64=
